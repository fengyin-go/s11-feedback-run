{
  "version": 1,
  "hard_groups": [
    {
      "id": "ai_transition",
      "label": "套话或 AI 腔的词",
      "terms": [
        "综上所述",
        "总而言之",
        "总体而言",
        "整体来看",
        "综合来看",
        "总的来说",
        "与此同时",
        "值得注意的是",
        "需要指出的是",
        "由此可见",
        "不难看出",
        "也就是说",
        "综上",
        "首先",
        "其次",
        "再者",
        "此外",
        "可以看出",
        "值得一提",
        "充分体现",
        "换言之",
        "进而",
        "从而"
      ],
      "guidance": "直接写事实，不要用作文式连接词或总结腔"
    },
    {
      "id": "empty_evaluation",
      "label": "没法核验的评价",
      "terms": [
        "整体表现不错",
        "整体不错",
        "效果很好",
        "基本可用",
        "表现出色",
        "质量较高",
        "完成度高",
        "功能完善",
        "实现完整",
        "显著提升",
        "极大地",
        "很好地",
        "稳定可靠",
        "高效便捷",
        "完美完成",
        "无明显问题"
      ],
      "guidance": "删掉评价词，补上用户实际做了什么、看到什么"
    },
    {
      "id": "empty_completion",
      "label": "空泛完成度句",
      "terms": [
        "未发现其他明确未完成功能",
        "未发现明确未完成功能",
        "未发现明显的未完成项",
        "其余要求未发现缺口",
        "没有发现其他待补功能",
        "现阶段没有明确的未完成项",
        "这一轮要改的功能都已落地"
      ],
      "guidance": "直接写完成了什么、还缺什么，不要补一句空泛的完成度结论"
    }
  ],
  "rewrite_groups": [
    {
      "id": "term.watermark",
      "terms": ["水位线", "水位"],
      "guidance": "改成上次处理位置、增量截止时间、下一批从哪里继续，或直接写已处理到哪条记录"
    },
    {
      "id": "term.chain",
      "terms": ["全链路", "核心链路", "主链路", "调用链", "链路"],
      "guidance": "改成用户从哪个入口操作、请求实际落到哪个接口，或页面和后端哪里没有对上"
    },
    {
      "id": "term.loop",
      "terms": ["闭环"],
      "guidance": "改成操作后能在哪里看到结果、失败后回到什么状态，或两处数据最终是否一致"
    },
    {
      "id": "term.fallback",
      "terms": ["兜底"],
      "guidance": "改成出错时返回什么、保留什么、显示什么提示"
    },
    {
      "id": "term.landing",
      "terms": ["落地"],
      "guidance": "改成已经能在页面完成、已经生效，或接口实际返回了什么"
    },
    {
      "id": "term.business_jargon",
      "terms": ["赋能", "抓手", "颗粒度", "心智", "生态", "组合拳"],
      "guidance": "删除包装词，直接写具体功能、入口、字段或操作"
    },
    {
      "id": "term.precipitate",
      "terms": ["沉淀"],
      "guidance": "改成保存、写入或保留"
    },
    {
      "id": "term.align",
      "terms": ["对齐", "拉齐"],
      "guidance": "改成两处显示同一个值、使用同一份数据，或数值实际一致"
    },
    {
      "id": "term.connect",
      "terms": ["打通"],
      "guidance": "改成页面能调用接口、一处修改后另一处能看到，或具体数据实际流向哪里"
    },
    {
      "id": "term.converge",
      "terms": ["收敛"],
      "guidance": "改成合并成一份、只保留一条，或同一次请求只产生一个结果"
    },
    {
      "id": "term.orchestration",
      "terms": ["编排"],
      "guidance": "改成按什么顺序执行、由哪个入口调度，或具体步骤如何推进"
    },
    {
      "id": "term.governance",
      "terms": ["治理"],
      "guidance": "改成清理、审批、归档、权限或审计等具体动作"
    },
    {
      "id": "term.observable",
      "terms": ["可观测"],
      "guidance": "改成用户能看到哪些状态、日志或错误原因"
    },
    {
      "id": "term.defensive",
      "terms": ["防御性"],
      "guidance": "改成遇到空值、越界或异常输入时实际返回什么"
    },
    {
      "id": "term.quality_adjective",
      "terms": ["可维护", "可扩展", "可演进"],
      "guidance": "只有实际核验过才写，并说明增加什么内容时不需要改哪里"
    },
    {
      "id": "term.robust",
      "terms": ["鲁棒", "健壮"],
      "guidance": "改成在什么输入或失败情况下仍能完成什么"
    },
    {
      "id": "term.graceful_degradation",
      "terms": ["优雅降级"],
      "guidance": "改成某项失败时保留什么、隐藏什么或给用户什么提示"
    },
    {
      "id": "term.consistency",
      "terms": ["一致性保障"],
      "guidance": "改成两处显示一致、数据没有丢失，或失败后回到原来的状态"
    },
    {
      "id": "term.engineering_wrapper",
      "terms": ["工程化", "结构化", "规范化", "精细化"],
      "guidance": "把包装词换成具体的字段、顺序、校验或页面结果"
    }
  ],
  "machine_summary_phrases": [
    "复用已有版本锁定",
    "没有依赖临时状态",
    "抽象名词串"
  ],
  "contextual_terms": [
    "能力",
    "方案",
    "策略",
    "机制",
    "流程",
    "维度",
    "层面",
    "体系",
    "联动",
    "同步",
    "回写",
    "校验",
    "隔离",
    "冻结",
    "准入",
    "降级",
    "保障",
    "归档"
  ],
  "thresholds": {
    "dense_unique_tokens": 6,
    "count_units": 5,
    "machine_fields": 3,
    "abstract_terms_error": 5,
    "abstract_terms_warning": 3,
    "exact_values_warning": 6
  }
}
